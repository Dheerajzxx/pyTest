# --- General ---------------------------------------------------------------
POSTING_TIMEOUT_SECONDS=15
# Optional comma separated allow-list, e.g. bluesky,mastodon. Leave empty to
# post to every platform that has credentials.
POSTING_PLATFORMS=

# --- Bluesky (app password from Settings > App Passwords) -------------------
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
BLUESKY_PDS_URL=https://bsky.social

# --- Mastodon (user token with the write:statuses scope) --------------------
MASTODON_INSTANCE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=
# public | unlisted | private | direct
MASTODON_VISIBILITY=public

# --- Telegram (bot added as channel admin, chat id like @my_channel) --------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Only used for numeric chat ids, public channels are detected from @username.
TELEGRAM_PUBLIC_ACCESS=false

# --- Discord (channel webhook: Channel settings > Integrations > Webhooks) --
DISCORD_WEBHOOK_URL=
DISCORD_PUBLIC_ACCESS=false

# --- DEV Community (API key from Settings > Extensions) --------------------
DEVTO_API_KEY=

# --- Reddit (script app at reddit.com/prefs/apps) --------------------------
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_SUBREDDIT=
REDDIT_USER_AGENT=automated-posting/1.0 by u/your_username
REDDIT_PUBLIC_ACCESS=true

# --- Endpoint overrides (only needed behind a proxy or a test stub) --------
TELEGRAM_API_BASE=https://api.telegram.org
DEVTO_API_BASE=https://dev.to/api
REDDIT_API_BASE=https://oauth.reddit.com
REDDIT_TOKEN_BASE=https://www.reddit.com
